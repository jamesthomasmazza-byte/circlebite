# Copy to .env on the server only. Never commit the real file. (CONTEST_RULES.md R8)

# PostgreSQL — self-hosted on this project's own EC2 instance (R6: no managed database)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/circlebite

# Session signing — generate with: openssl rand -hex 32
SESSION_SECRET=

# AI provider (Anthropic) — use a sandbox key with a hard spend cap set on the console.
# AI_MODEL defaults to claude-haiku-4-5-20251001 if unset. AI_API_KEY may be left empty in any
# environment — the verdict engine fails closed to unable_to_confirm when it's missing, it does
# not break other scan types.
AI_API_KEY=
AI_MODEL=

# In-app defense-in-depth spend rail, separate from the console-side cap on the key itself.
# Defaults to 200 (=$2.00/day) if unset.
AI_DAILY_SPEND_CAP_CENTS=

# Open Food Facts requires a descriptive User-Agent
OFF_USER_AGENT=CircleBite/1.0 (mazzajt@cua.edu)

# Correction photo storage. REQUIRED — the app refuses to boot without it (no default; a prior
# default of ./uploads relative to the server process's cwd was a live bug, since that resolves to
# inside the versioned release tree in production and every correction photo was deleted on the
# next deploy). Production MUST point outside the release tree entirely — e.g.
# /home/ubuntu/circlebite/uploads, a sibling of releases/ and current/, not inside either of them.
# Local dev needs its own value too (e.g. an uploads/ directory under the server workspace —
# covered by .gitignore's `uploads/` pattern at any depth).
UPLOAD_DIR=

# Kill switch: whether corroborated community corrections change what OTHER profiles see on a scan
# of the same barcode (a reporter's own corrections always apply to their own view). "on" or "off";
# anything else refuses to boot. Defaults to off if blank. Turning it off and restarting reverts
# every other profile's view immediately — see docs/server-setup.md §11.
COMMUNITY_CORRECTIONS=

# Kill switch: Path C (docs/verdict-engine.md) — photographing an ingredients label instead of
# scanning a barcode. "on" or "off"; anything else refuses to boot. Defaults to off if blank.
# Turning it off and restarting makes POST /scans/label 404 again — no data changes.
LABEL_SCAN=

# Kill switch: whether a pending report that adds a warning is shared with everyone who can read the
# profile it was filed from, on every scan of that barcode — not only the reporter's own scan.
# "on" or "off"; anything else refuses to boot. Defaults to off if blank. Off: each pending report
# changes only its reporter's view of one scan. No data changes either way.
CIRCLE_ESCALATIONS=

# Switch: whether the camera scanner decodes only inside its target box instead of the whole frame.
# "on" or "off"; anything else refuses to boot. Defaults to off if blank, which is whole-frame
# decoding. Turning it off and restarting takes effect on each phone's next page load — see
# docs/server-setup.md §11b.
SCANNER_REGION=

# Switch: follow requests — asking to follow a parent by typing their account's email address, for
# the owner to approve or decline. "on" or "off"; anything else refuses to boot. Defaults to off if
# blank. Off makes every request route 404 and hides the form, notice and badge; requests already
# waiting stay, untouched. See docs/server-setup.md §11c.
CIRCLE_REQUESTS=

# Switch: the guided profile setup — one question at a time, answered by tapping, saved through the
# same POST /profiles. No AI. "on" or "off"; anything else refuses to boot. Defaults to off if
# blank, which opens the classic add-profile form. See docs/server-setup.md §11d.
GUIDED_SETUP=

# Backups (docs/server-setup.md §17). Production only — the app never reads either.
# BACKUP_S3_BUCKET: the private bucket scripts/backup.sh copies each night's set to. A name, not a
# secret; it lives here so no bucket name is ever written into the repo.
BACKUP_S3_BUCKET=
# RESTORE_TEST_DB_PASSWORD: for the circlebite_restoretest role, which scripts/restore-test.sh
# uses to restore into a scratch database. Generated on the box, never typed — see §17.
RESTORE_TEST_DB_PASSWORD=

APP_URL=https://
NODE_ENV=production
PORT=3000
