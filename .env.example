# Copy to .env on the server only. Never commit the real file. (CONTEST_RULES.md R8)

# PostgreSQL — self-hosted on this project's own EC2 instance (R6: no managed database)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/circlebite

# Session signing — generate with: openssl rand -hex 32
SESSION_SECRET=

# AI provider (Anthropic) — use a sandbox key with a hard spend cap set on the console.
# AI_MODEL defaults to claude-haiku-4-5-20251001 if unset. AI_API_KEY may be left empty in any
# environment — the verdict engine fails closed to unable_to_confirm when it's missing, it does
# not break other scan types.
AI_API_KEY=
AI_MODEL=

# In-app defense-in-depth spend rail, separate from the console-side cap on the key itself.
# Defaults to 200 (=$2.00/day) if unset.
AI_DAILY_SPEND_CAP_CENTS=

# Open Food Facts requires a descriptive User-Agent
OFF_USER_AGENT=CircleBite/1.0 (mazzajt@cua.edu)

# Correction photo storage. REQUIRED — the app refuses to boot without it (no default; a prior
# default of ./uploads relative to the server process's cwd was a live bug, since that resolves to
# inside the versioned release tree in production and every correction photo was deleted on the
# next deploy). Production MUST point outside the release tree entirely — e.g.
# /home/ubuntu/circlebite/uploads, a sibling of releases/ and current/, not inside either of them.
# Local dev needs its own value too (e.g. an uploads/ directory under the server workspace —
# covered by .gitignore's `uploads/` pattern at any depth).
UPLOAD_DIR=

APP_URL=https://
NODE_ENV=production
PORT=3000
